# Copy to .env and paste your keys. .env is git-ignored — never commit real keys.
# Key for the "Explain this portfolio" commentary (POST /api/explain).
GEMINI_API_KEY=your-key-here
# Optional dedicated key for the Copilot agent (POST /api/agent/chat); falls back to GEMINI_API_KEY.
GEMINI_API_KEY_AGENT=your-second-key-here
